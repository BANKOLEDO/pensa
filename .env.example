# ============================================================
# PENSA environment configuration
# Copy to .env and fill in. For local dev the app runs fully
# in SIMULATION mode without a chain or API keys (zero config).
# ============================================================

# --- Runtime mode -------------------------------------------------
# "dev"  -> full simulation (in-memory vaults, demo data, no chain)
# "staging" -> talks to X Layer testnet, AI uses fallback if no key
# "prod" -> talks to X Layer mainnet, requires private key + factory
APP_ENV=dev

# --- X Layer ------------------------------------------------------
X_LAYER_RPC=https://rpc.xlayer.tech
X_LAYER_TESTNET_RPC=https://testrpc.xlayer.tech
CHAIN_ID=196

# --- Deployer / agent wallets ------------------------------------
# NEVER commit real keys. Left blank the protocol uses simulation.
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Set automatically by scripts/deploy.js (written to deployments/).
FACTORY_ADDRESS=

# --- AI (Hugging Face, free tier) --------------------------------
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Retry/cooldown between HF calls when rate limited (seconds)
AI_FALLBACK_SLEEP=20

# --- Telegram bot (free via @BotFather) --------------------------
TELEGRAM_BOT_TOKEN=
# Chat id that receives admin alerts (optional)
ADMIN_CHAT_ID=

# --- Market data ---------------------------------------------------
# CoinGecko free tier is default. Set to a paid key to unlock more.
COINGECKO_API_KEY=
