{
  "name": "pensa-protocol",
  "version": "1.0.0",
  "description": "PENSA — AI-managed micro-pension protocol for gig workers on OKX X Layer",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.js --network xlayerTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network xlayer",
    "verify:testnet": "hardhat run scripts/verify.js --network xlayerTestnet",
    "verify:mainnet": "hardhat run scripts/verify.js --network xlayer",
    "seed:local": "hardhat run scripts/seed.js --network localhost",
    "seed:testnet": "hardhat run scripts/seed.js --network xlayerTestnet",
    "backend": "uvicorn backend.server:app --reload --port 8000",
    "agent": "python ai-agent/agent.py",
    "bot": "python bot/telegram_bot.py"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "chai": "^6.2.2",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "keccak",
      "secp256k1"
    ]
  }
}
